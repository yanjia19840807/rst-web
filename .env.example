# Copy values into .env.local for personal overrides (gitignored).
# Modes: development (npm run dev) · uat · pre · production (npm run build)

# Empty = same-origin /api (Vite proxy in development, reverse proxy when deployed).
VITE_API_BASE_URL=
VITE_ENABLE_MSW=false
# true only on deployed uat / pre / prod builds.
VITE_SSO_ENABLED=false
