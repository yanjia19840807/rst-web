# Copy values into .env.local for personal overrides (gitignored).
# Modes: development (npm run dev) · dev (npm run build:dev) · uat · pre · production (npm run build)

# API calls use same-origin /api. Set VITE_API_BASE_URL only to point at another host.
# npm run dev leaves SSO on. npm run dev:local sets VITE_SSO_ENABLED=false for that process.
# Do not set VITE_SSO_ENABLED in .env.local; that file loads for uat / pre / production builds too.
